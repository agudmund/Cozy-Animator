    {
      "node_id": 0,
      "node_type": "about",
      "title": "And both One and Five are an enigma to Three",
      "uuid": "725c4687c21d479488ee1bef26a5b149",
      "x": 5790.936173455906,
      "y": 1268.5389151105023,
      "width": 468.0,
      "height": 29.0,
      "z_value": -9.96300000000002,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "And both One and Five are an enigma to Three",
      "depth_front": false,
      "node_tint": ""
    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "But I can try to elaborate",
