    {
      "node_id": 0,
      "node_type": "warm",
      "title": "Onward",
      "uuid": "7bda01e27c2d4a1a9df1961c27ebc0a0",
      "x": 6053.348823491855,
      "y": 602.0172059936017,
      "width": 304.7408703952204,
      "height": 148.1825688885001,
      "z_value": -9.969000000000017,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "With that all in mind\nLets also keep in mind\nThat One and Five\nAre default near identical trraversing souls"
    },
    {
      "node_id": 0,
      "node_type": "warm",
      "title": "Clear Vision",
      "uuid": "13452816524344e2b17b5697aac68db6",
      "x": 6172.784524919611,
      "y": 1368.433747640112,
      "width": 295.17791648684687,
      "height": 159.7113698977705,
      "z_value": -9.962000000000021,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "Two in this case\nThe transfer of understanding from One to Three\nIs how Three understands The One\nAnd interprets that information\nInto it's own understanding\nFor any of it to make sense to Three"
    },
