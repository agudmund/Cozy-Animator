    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "The Five becomes horrified",
      "uuid": "77077386b389460f9fdeb9b7237a942f",
      "x": 6213.833099754454,
      "y": 2105.780077212401,
      "width": 287.015625,
      "height": 29.0,
      "z_value": -9.957000000000024,
      "ports_visible": false,
      "shelf_visible": false,
      "label": "The Five becomes horrified",
      "depth_front": false,
      "node_tint": ""
    },
    {
      "node_id": 0,
      "node_type": "about",
      "title": "Its a form of a pathogen carrier",
      "uuid": "960c31afd81240e1810e482303456de8",
      "x": 5987.738810367053,
      "y": 2634.811728135403,
      "width": 348.0,
