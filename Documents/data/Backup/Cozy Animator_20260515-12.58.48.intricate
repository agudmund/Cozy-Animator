      "title": "Good",
      "uuid": "9a78902c8efd412bbbbb556288acb84b",
      "x": 6231.246248065094,
      "y": 1772.7324232103524,
      "width": 209.7212201255178,
      "height": 143.5332375541493,
      "z_value": -9.959000000000023,
      "ports_visible": false,
      "shelf_visible": true,
      "body_text": "Now what happens\nWhen Three talks to Five\nIs Four\nThe transfer of understanding\nBetween Three and Five"
