<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CozyAnimator.MainPage"
             Title="Cozy Animator – 3 Column Test"
             BackgroundColor="#1E1E1E"
             Padding="24">

    <!-- Root Grid with fixed column widths -->
    <Grid ColumnDefinitions="480,80,480">

        <!-- LEFT - Text Input -->
        <VerticalStackLayout Grid.Column="0" Spacing="8" Padding="0,0,12,0">
            <Label Text="Left Text Input" TextColor="#A78BFA" FontSize="16" FontAttributes="Bold"/>
            <ScrollView HeightRequest="520">
                <Editor BackgroundColor="#2A2A2A"
                        TextColor="#E0E0E0"
                        Placeholder="Type here..."
                        FontSize="17"
                        AutoSize="TextChanges"/>
            </ScrollView>
        </VerticalStackLayout>

        <!-- MIDDLE - Slider in its own fixed container -->
        <!-- HeightRequest="520" -->
        <Grid Grid.Column="1" WidthRequest="80" HeightRequest="520">
            <Slider x:Name="middleSlider"
                    Minimum="0" Maximum="100" Value="50"
                    MinimumTrackColor="#6B5A47"
                    MaximumTrackColor="#444444"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="520"
                    Rotation="270"/>
        </Grid>

        <!-- RIGHT - Text Input -->
        <VerticalStackLayout Grid.Column="2" Spacing="8" Padding="12,0,0,0">
            <Label Text="Right Text Input" TextColor="#A78BFA" FontSize="16" FontAttributes="Bold"/>
            <ScrollView HeightRequest="520">
                <Editor BackgroundColor="#2A2A2A"
                        TextColor="#E0E0E0"
                        Placeholder="Type here..."
                        FontSize="17"
                        AutoSize="TextChanges"/>
            </ScrollView>
        </VerticalStackLayout>

    </Grid>
</ContentPage>